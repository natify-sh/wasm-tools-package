# The sdist must be buildable on its own: the build hooks, the package sources, and the wasm-tools submodule (the whole Cargo
# workspace: cargo reads the manifests of all its members, even to build one binary). setuptools-scm lists git files but does
# not recurse into submodules, so the submodule is grafted explicitly. Of wasm-tools' own submodules (the spec testsuites, only
# for its tests) nothing is needed; the crates it depends on are fetched from crates.io by cargo (`--locked`, so by Cargo.lock).
include build_wasm_tools.py setup.py README.md LICENSE NOTICE.md
graft src
prune src/wasm_tools_package/bin
exclude src/wasm_tools_package/_wasm_tools_version.txt
graft tests

graft wasm-tools
prune wasm-tools/.git
prune wasm-tools/target
prune wasm-tools/tests/testsuite
prune wasm-tools/tests/component-model

global-exclude __pycache__ *.py[cod] .git
